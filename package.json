{
  "name": "portariasync",
  "version": "1.0.0",
  "private": true,
  "description": "PortariaSync para Associacao de Moradores",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "db:check": "node scripts/migrate-structured-db.js",
    "db:migrate": "node scripts/migrate-structured-db.js --apply",
    "receipts:init": "node scripts/initialize-withdrawal-receipts.js",
    "receipts:daemon": "node scripts/withdrawal-receipt-daemon.js",
    "occurrences:init": "node scripts/initialize-occurrences.js",
    "residents:server": "node scripts/resident-management-server.js",
    "whatsapp:webhook": "node scripts/whatsapp-webhook-server.js",
    "whatsapp:webhooks:configure": "node scripts/configure-zapi-webhooks.js",
    "whatsapp:status": "node scripts/whatsapp-delivery-status.js",
    "postinstall": "node scripts/prepare-vision.js",
    "prepare:vision": "node scripts/prepare-vision.js",
    "prestart": "node scripts/prepare-vision.js"
  },
  "dependencies": {
    "@tesseract.js-data/por": "1.0.0",
    "@zxing/library": "0.21.3",
    "tesseract.js": "7.0.0"
  }
}