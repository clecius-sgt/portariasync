PORT=3000

# Login inicial
ADMIN_PASSWORD=troque-esta-senha

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# OCR local: sem chave de API ou serviço contratado.

# WhatsApp
# O PortariaSync usa Z-API como provedor padrão.
WHATSAPP_PROVIDER=zapi

# Z-API
ZAPI_URL=https://api.z-api.io/instances/SUA_INSTANCIA/token/SEU_TOKEN
ZAPI_CLIENT=SEU_CLIENT_TOKEN

# Meta WhatsApp Cloud API permanece apenas como suporte opcional e inativo.
# Só será usada se WHATSAPP_PROVIDER=meta for definido explicitamente.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_GRAPH_API_VERSION=
META_WHATSAPP_TEMPLATE_PACKAGE=aviso_encomenda_portaria
META_WHATSAPP_TEMPLATE_REMINDER=lembrete_encomenda_portaria
META_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
