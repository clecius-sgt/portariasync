PORT=3000

# Login inicial
ADMIN_PASSWORD=troque-esta-senha

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# OCR local: sem chave de API ou serviço contratado.

# WhatsApp
# Use "meta" para a API oficial da Meta ou "zapi" durante a transição.
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API
# Consulte no painel da Meta a versão Graph API atualmente ativa para sua aplicação.
META_WHATSAPP_ACCESS_TOKEN=COLE_AQUI_O_TOKEN_PERMANENTE
META_WHATSAPP_PHONE_NUMBER_ID=COLE_AQUI_O_PHONE_NUMBER_ID
META_WHATSAPP_WABA_ID=COLE_AQUI_O_WABA_ID
META_GRAPH_API_VERSION=COLE_AQUI_A_VERSAO_ATIVA
META_WHATSAPP_TEMPLATE_PACKAGE=aviso_encomenda_portaria
META_WHATSAPP_TEMPLATE_REMINDER=lembrete_encomenda_portaria
META_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Z-API legado, opcional. Mantenha apenas enquanto WHATSAPP_PROVIDER=zapi.
ZAPI_URL=https://api.z-api.io/instances/SUA_INSTANCIA/token/SEU_TOKEN
ZAPI_CLIENT=SEU_CLIENT_TOKEN
