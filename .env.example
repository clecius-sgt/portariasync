PORT=3000

# Login inicial
ADMIN_PASSWORD=troque-esta-senha

# Multi-Associação
# Nome exibido para a associação principal que já utiliza o PortalSync.
# As demais associações são cadastradas pelo painel /associacoes.html.
DEFAULT_ASSOCIATION_NAME=Associação de Moradores

# Gestão de Moradores
# Serviço interno dedicado. O Caddy publica somente /api/residents/*.
RESIDENT_MANAGEMENT_PORT=3003

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# OCR local: sem chave de API ou serviço contratado.

# Alertas inteligentes de permanência
# O daemon verifica as encomendas pendentes periodicamente.
PACKAGE_ALERTS_INTERVAL_MINUTES=15
PACKAGE_ALERTS_STARTUP_DELAY_MS=5000

# WhatsApp
# O PortariaSync usa Z-API como provedor padrão.
WHATSAPP_PROVIDER=zapi

# Z-API
ZAPI_URL=https://api.z-api.io/instances/SUA_INSTANCIA/token/SEU_TOKEN
ZAPI_CLIENT=SEU_CLIENT_TOKEN

# Rastreamento real de entrega Z-API
# O configurador gera ZAPI_WEBHOOK_SECRET automaticamente no .env de produção.
PORTARIASYNC_PUBLIC_URL=https://portaria.clecius.tech
WHATSAPP_TRACKING_ENABLED=1
WHATSAPP_WEBHOOK_PORT=3002
ZAPI_WEBHOOK_SECRET=
# Opcional. Se vazio, usa data/whatsapp-delivery.sqlite.
WHATSAPP_TRACKING_DB=

# Meta WhatsApp Cloud API permanece apenas como suporte opcional e inativo.
# Só será usada se WHATSAPP_PROVIDER=meta for definido explicitamente.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_GRAPH_API_VERSION=
META_WHATSAPP_TEMPLATE_PACKAGE=aviso_encomenda_portaria
META_WHATSAPP_TEMPLATE_REMINDER=lembrete_encomenda_portaria
META_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR